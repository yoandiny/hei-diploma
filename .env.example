# Template for local env. Copy to .env then adjust values:
#   cp .env.example .env

SERVER_PORT=8080

SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
# Keep special characters as-is; run.sh parses values safely (no need to quote).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/hei_diploma?sslmode=prefer

# HS256 requires at least 32 characters
JWT_SECRET=change-me-to-a-long-random-secret-key
APP_JWT_EXPIRATION_SECONDS=86400

AWS_REGION=eu-west-3
AWS_S3_BUCKET=dummy-bucket
AWS_EVENTBRIDGE_BUS=dummy-bus
AWS_SES_SOURCE=noreply@poja.io
AWS_EVENT_STACK_1_SQS_QUEUE_URL=https://sqs.eu-west-3.amazonaws.com/000000000000/dummy-queue-1
AWS_EVENT_STACK_2_SQS_QUEUE_URL=https://sqs.eu-west-3.amazonaws.com/000000000000/dummy-queue-2
